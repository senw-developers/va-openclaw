# free-tier-seed .env example (ONE shared instance for the whole free tier)
#
# 1. Copy to .env in this directory (kept local — `.env` is gitignored repo-wide).
# 2. Fill the required values below; leave optional lines commented unless needed.
# 3. Run docker-setup.sh (reads this file via docker-compose).
#
# This seed is the SHARED free-tier box (openclaw name `nabu-free-tier`): every
# free org is a sub-agent `agent-org-<orgId>`, org is derived per-request, and
# files-api is served by the broker (no per-org config token). For the dedicated
# per-tenant seed use ../spawn-seed instead.
#
# Never commit a filled .env: values committed before 2026-08 are burned (G4).

# ------------------------------------------------------------------
# Shared-instance identity
# ------------------------------------------------------------------
# LEAVE EMPTY. This is the shared box — org is derived per-request from the
# agent id (agent-org-<orgId>). A filled value flips nabu-files to the dedicated
# path and demands a config skill token the shared instance does not have.
OPENCLAW_ORGANIZATION_ID=
NABU_ENVIRONMENT=

# ------------------------------------------------------------------
# Compose / stack
# ------------------------------------------------------------------
COMPOSE_PROJECT_NAME=
# OPENCLAW_IMAGE=openclaw:local
# OPENCLAW_GATEWAY_PORT=18789
# OPENCLAW_BRIDGE_PORT=18790
# OPENCLAW_CONFIG_DIR=~/.openclaw
# OPENCLAW_WORKSPACE_DIR=~/.openclaw/workspace
# OPENCLAW_AUTH_PROFILE_SECRET_DIR=~/.openclaw-auth-profile-secrets
# OPENCLAW_HOME_VOLUME=
# OPENCLAW_EXTRA_MOUNTS=
# OPENCLAW_TZ=UTC

# ------------------------------------------------------------------
# Backend reachability (substituted into openclaw.json)
# ------------------------------------------------------------------
# Must resolve FROM INSIDE the container. The defaults below are docker-compose
# service names and only resolve in the backend's development compose —
# staging/production must override both with the overlay address, or every nabu
# plugin call fails DNS. Empty is not allowed: config load throws MissingEnvVarError.
# NABU_APP_BASE_URL=http://app:6001
# NABU_GATEWAY_BASE_URL=http://nabu-gateway:6200

# ------------------------------------------------------------------
# Gateway (token required; minted by docker-setup.sh if empty)
# ------------------------------------------------------------------
OPENCLAW_GATEWAY_TOKEN=
# OPENCLAW_GATEWAY_MODE=
# OPENCLAW_GATEWAY_BIND=lan
# Prod pins the published ports to the overlay IP so the gateway has no public
# inbound. Leave unset for dev (0.0.0.0). The overlay iface must exist first.
# OPENCLAW_GATEWAY_BIND_IP=
# OPENCLAW_DISABLE_BONJOUR=1
# OPENCLAW_ALLOW_INSECURE_PRIVATE_WS=

# ------------------------------------------------------------------
# Image build / runtime extras
# ------------------------------------------------------------------
# OPENCLAW_EXTENSIONS=
# OPENCLAW_DOCKER_APT_PACKAGES=
# OPENCLAW_SANDBOX=
# OPENCLAW_DOCKER_SOCKET=/var/run/docker.sock
# DOCKER_GID=
# OPENCLAW_INSTALL_DOCKER_CLI=

# ------------------------------------------------------------------
# Provider / files-api secrets (required for the shared free-tier instance)
# ------------------------------------------------------------------
# The primary model provider (agents.defaults.model.primary = minimax/MiniMax-M2.7).
MINIMAX_API_KEY=
# Files-api actor secret: nabu-files brokers a per-org token from this. It is the
# SOLE files-api credential on the shared box (no per-org NABU_FILES_SKILL_TOKEN).
# Absent => the broker fails closed and free-tier uploads are refused. The operator
# fills the SAME value the backend holds in NABU_FREE_TIER_BROKER_TOKEN.
NABU_FREE_TIER_BROKER_TOKEN=
# Optional: only used by nabu-model-router, which is disabled for free tier.
# CLOUDFLARE_AI_GATEWAY_API_KEY=
