# free-tier-seed — SHARED FREE-TIER BOX (openclaw name `nabu-free-tier`)
#
# Copy to .env, fill the values, run ./docker-setup.sh. .env is gitignored — never
# commit a filled one. Org is derived per-request from agent-org-<orgId>; files-api
# is served by the broker (no per-org skill token). Structurally mirrors the
# standalone instance .env; only free-tier values differ.

# ------------------------------------------------------------------
# Tenant identity
# ------------------------------------------------------------------
# LEAVE EMPTY — shared box. A value flips nabu-files to the dedicated path and
# demands a config skill token the shared box does not have.
OPENCLAW_ORGANIZATION_ID=
NABU_ENVIRONMENT=

# ------------------------------------------------------------------
# Compose / stack
# ------------------------------------------------------------------
COMPOSE_PROJECT_NAME=nabu-free-tier
OPENCLAW_IMAGE=openclaw:local
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790
OPENCLAW_CONFIG_DIR=./.openclaw
OPENCLAW_WORKSPACE_DIR=./.openclaw/workspace
OPENCLAW_AUTH_PROFILE_SECRET_DIR=./.openclaw-auth-profile-secrets
OPENCLAW_TZ=UTC

# ------------------------------------------------------------------
# Backend reachability — set to the overlay address for staging/production
# ------------------------------------------------------------------
# Both must resolve FROM INSIDE the container; the dev defaults
# (app:6001 / nabu-gateway:6200) only work in the backend's dev compose.
NABU_APP_BASE_URL=
NABU_GATEWAY_BASE_URL=

# ------------------------------------------------------------------
# Gateway — token MINTED by docker-setup.sh when left empty
# ------------------------------------------------------------------
# OPENCLAW_GATEWAY_TOKEN must equal the backend's NABU_FREE_TIER_GATEWAY_TOKEN.
# Prod: set OPENCLAW_GATEWAY_BIND_IP to the overlay so there is no public inbound.
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_GATEWAY_BIND=lan
OPENCLAW_GATEWAY_BIND_IP=0.0.0.0
OPENCLAW_DISABLE_BONJOUR=1
OPENCLAW_SKIP_ONBOARDING=1
OPENCLAW_ALLOW_INSECURE_PRIVATE_WS=

# ------------------------------------------------------------------
# Model provider + files-api broker (both required)
# ------------------------------------------------------------------
# MiniMax is the primary model. NABU_FREE_TIER_BROKER_TOKEN must equal the backend's
# NABU_FREE_TIER_BROKER_TOKEN (per-environment; the dev token is dev-only).
# Empty => nabu-files fails closed and free-tier uploads are refused.
MINIMAX_API_KEY=
NABU_FREE_TIER_BROKER_TOKEN=

# ------------------------------------------------------------------
# Unused on the free-tier box (plugins off; broker replaces the files token)
# ------------------------------------------------------------------
CLOUDFLARE_AI_GATEWAY_API_KEY=
NABU_FILES_SKILL_TOKEN=
NABU_EMAIL_SKILL_TOKEN=
NABU_GOOGLE_WORKSPACE_SKILL_TOKEN=
NABU_ONE_PASSWORD_SKILL_TOKEN=
OPENCLAW_EXTRA_MOUNTS=
OPENCLAW_HOME_VOLUME=
OPENCLAW_IMAGE_APT_PACKAGES=
OPENCLAW_IMAGE_PIP_PACKAGES=
OPENCLAW_EXTENSIONS=
OPENCLAW_INSTALL_BROWSER=
OPENCLAW_SANDBOX=
OPENCLAW_DOCKER_SOCKET=/var/run/docker.sock
DOCKER_GID=
OPENCLAW_INSTALL_DOCKER_CLI=

# ------------------------------------------------------------------
# OpenTelemetry (optional) — leave empty unless exporting
# ------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=
OTEL_SERVICE_NAME=
OTEL_SEMCONV_STABILITY_OPT_IN=
OPENCLAW_OTEL_PRELOADED=
