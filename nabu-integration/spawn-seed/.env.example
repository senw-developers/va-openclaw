# Spawn-seed .env example (per-tenant gateway stack)
#
# 1. Copy to .env in this directory (kept local — `.env` is gitignored repo-wide).
# 2. Fill the required values below; leave optional lines commented unless needed.
# 3. Run docker-setup.sh (reads this file via docker-compose).
#
# Never commit a filled .env: values committed before 2026-08 are burned (G4).

# ------------------------------------------------------------------
# Tenant identity (required)
# ------------------------------------------------------------------
OPENCLAW_ORGANIZATION_ID=
NABU_ENVIRONMENT=

# ------------------------------------------------------------------
# Compose / stack
# ------------------------------------------------------------------
COMPOSE_PROJECT_NAME=
# OPENCLAW_IMAGE=openclaw:local
# OPENCLAW_GATEWAY_PORT=18789
# OPENCLAW_BRIDGE_PORT=18790
# OPENCLAW_CONFIG_DIR=~/.openclaw
# OPENCLAW_WORKSPACE_DIR=~/.openclaw/workspace
# OPENCLAW_HOME_VOLUME=
# OPENCLAW_EXTRA_MOUNTS=
# OPENCLAW_TZ=UTC

# ------------------------------------------------------------------
# Gateway (token required; minted by docker-setup.sh if empty)
# ------------------------------------------------------------------
OPENCLAW_GATEWAY_TOKEN=
# OPENCLAW_GATEWAY_MODE=
# OPENCLAW_GATEWAY_BIND=lan
# OPENCLAW_DISABLE_BONJOUR=1
# OPENCLAW_ALLOW_INSECURE_PRIVATE_WS=

# ------------------------------------------------------------------
# Image build / runtime extras
# ------------------------------------------------------------------
# OPENCLAW_EXTENSIONS=
# OPENCLAW_DOCKER_APT_PACKAGES=
# OPENCLAW_SANDBOX=
# OPENCLAW_DOCKER_SOCKET=/var/run/docker.sock
# DOCKER_GID=
# OPENCLAW_INSTALL_DOCKER_CLI=

# ------------------------------------------------------------------
# Provider / skill secrets (required for the nabu plugins)
# ------------------------------------------------------------------
CLOUDFLARE_AI_GATEWAY_API_KEY=
MINIMAX_API_KEY=
NABU_FILES_SKILL_TOKEN=
