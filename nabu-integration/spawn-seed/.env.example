# Spawn-seed .env example (per-tenant gateway stack)
#
# 1. Copy to .env in this directory (kept local — `.env` is gitignored repo-wide).
# 2. Fill the required values below; leave optional lines commented unless needed.
# 3. Run docker-setup.sh (reads this file via docker-compose).
#
# Never commit a filled .env: values committed before 2026-08 are burned (G4).

# ------------------------------------------------------------------
# Tenant identity (required)
# ------------------------------------------------------------------
OPENCLAW_ORGANIZATION_ID=
NABU_ENVIRONMENT=

# ------------------------------------------------------------------
# Compose / stack
# ------------------------------------------------------------------
COMPOSE_PROJECT_NAME=
# OPENCLAW_IMAGE=openclaw:local
# OPENCLAW_GATEWAY_PORT=18789
# OPENCLAW_BRIDGE_PORT=18790
# OPENCLAW_CONFIG_DIR=~/.openclaw
# OPENCLAW_WORKSPACE_DIR=~/.openclaw/workspace
# OPENCLAW_AUTH_PROFILE_SECRET_DIR=~/.openclaw-auth-profile-secrets
# OPENCLAW_HOME_VOLUME=
# OPENCLAW_EXTRA_MOUNTS=
# OPENCLAW_TZ=UTC

# ------------------------------------------------------------------
# Backend reachability (substituted into openclaw.json)
# ------------------------------------------------------------------
# Must resolve FROM INSIDE the tenant container. The defaults below are
# docker-compose service names and only resolve in the backend's development
# compose — staging/production must override both with the overlay address, or
# every nabu plugin call fails DNS. Empty is not allowed: config load throws
# MissingEnvVarError.
# NABU_APP_BASE_URL=http://app:6001
# NABU_GATEWAY_BASE_URL=http://nabu-gateway:6200

# ------------------------------------------------------------------
# Gateway (token required; minted by docker-setup.sh if empty)
# ------------------------------------------------------------------
OPENCLAW_GATEWAY_TOKEN=
# OPENCLAW_GATEWAY_MODE=
# OPENCLAW_GATEWAY_BIND=lan
# Prod pins the published ports to the overlay IP so the gateway has no public
# inbound. Leave unset for dev (0.0.0.0). The overlay iface must exist first.
# OPENCLAW_GATEWAY_BIND_IP=
# OPENCLAW_DISABLE_BONJOUR=1
# OPENCLAW_ALLOW_INSECURE_PRIVATE_WS=

# ------------------------------------------------------------------
# Image build / runtime extras
# ------------------------------------------------------------------
# OPENCLAW_EXTENSIONS=
# OPENCLAW_DOCKER_APT_PACKAGES=
# OPENCLAW_SANDBOX=
# OPENCLAW_DOCKER_SOCKET=/var/run/docker.sock
# DOCKER_GID=
# OPENCLAW_INSTALL_DOCKER_CLI=

# ------------------------------------------------------------------
# Provider / skill secrets (required for the nabu plugins)
# ------------------------------------------------------------------
CLOUDFLARE_AI_GATEWAY_API_KEY=
MINIMAX_API_KEY=
NABU_FILES_SKILL_TOKEN=
NABU_EMAIL_SKILL_TOKEN=
NABU_GOOGLE_WORKSPACE_SKILL_TOKEN=
# nabu-1password stays disabled until the backend broker route ships (B7).
NABU_ONE_PASSWORD_SKILL_TOKEN=
