{
  "id": "nabu-usage",
  "name": "@va-team/nabu-usage",
  "description": "Forward LLM usage events to the VA.Team backend for Cloudflare AI Gateway cost tracking",
  "enabledByDefault": true,
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "apiBaseUrl": {
        "type": "string",
        "description": "NestJS backend base URL — Docker-internal",
        "default": "http://app:6000"
      }
    }
  },
  "uiHints": {
    "apiBaseUrl": {
      "label": "API Base URL",
      "placeholder": "http://app:6000"
    }
  }
}
